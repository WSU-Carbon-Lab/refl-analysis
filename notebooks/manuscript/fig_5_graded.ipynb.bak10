        "## 3. Helpers\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 14,
      "id": "e7c0dcee",
      "metadata": {
        "execution": {
          "iopub.execute_input": "2026-09-11T21:15:59.537921Z",
          "iopub.status.busy": "2026-09-11T21:15:59.537864Z",
          "iopub.status.idle": "2026-09-11T21:15:59.542303Z",
          "shell.execute_reply": "2026-09-11T21:15:59.542009Z"
        }
